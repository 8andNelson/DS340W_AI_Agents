OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# openrouter (default) | freellmapi (local router) | anthropic (Claude -- needs ANTHROPIC_API_KEY)
LLM_PROVIDER=openrouter
# FreeLLMAPI: the unified key from its Keys page (http://localhost:3001)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_SMART_MODEL=auto:smart
# Folder with FreeLLMAPI's docker-compose.yml; the dashboard runs `docker compose up -d` there
FREELLMAPI_COMPOSE_DIR=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Web search: Brave first, then SerpApi (Google results, serpapi.com) when Brave fails or hits its limit
BRAVE_API_KEY=
SERPENT_API_KEY=
# Free local browser fallback. Install its browser with: python -m camoufox fetch
CAMOUFOX_ENABLED=true
CAMOUFOX_TIMEOUT_SECONDS=180
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ERRORS_CHANNEL_ID=
KAGGLE_USERNAME=
KAGGLE_KEY=
# Short name of the team member running the pipeline (recorded with each run's metrics; not an email)
MEMORY_CONTRIBUTOR=
# Shared agent memory: sqlite (local only, default) | postgres (team's hosted store) | off
MEMORY_BACKEND=sqlite
# Postgres connection string of the restricted memory_agent role (never the admin one).
# The admin URL (MEMORY_ADMIN_DATABASE_URL) is set only in the shell when running
# `python -m src.memory migrate`, never in this file.
MEMORY_DATABASE_URL=
# Whether agents use memory: read_write (default) | read (recall only, bank fixed) | off (control group)
MEMORY_MODE=read_write
MEMORY_PACK_CHARS=12000
MEMORY_MAX_REQUESTS_PER_CALL=2
# Fast mode (adapt a good past script), curator lessons (one LLM call per run), retry reordering (one short call)
MEMORY_REUSE=true
MEMORY_CURATOR=true
MEMORY_RERANK=true
